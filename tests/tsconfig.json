{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [
      "jest",
      "node"
    ],
    "allowJs": true,

  },
  "include": [
    "**/*.ts"
  ],
  // The root tsconfig excludes `**\/tests/**`; without an override that pattern
  // also excludes this project's own files, so TypeScript reports "No inputs".
  "exclude": [
    "node_modules/**",
    "dist/**"
  ],
}