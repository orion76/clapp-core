{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [
      "jest",
      "node"
    ],
    "allowJs": true,
    "paths": {
      "@clapp/common": [
        "../common/src/public-api.ts"
      ]
    }
  },
  "include": [
    "tests/**/*.ts"
  ],
  "exclude": [
    "dist/**",
    "node_modules/**"
  ]
}