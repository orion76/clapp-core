{
  "name": "@clapp/core",
  "version": "0.0.7-alpha.16",
  "type": "module",
  "description": "TypeScript CLI library with Commander and plugin system",
  "license": "MIT",
  "author": "Paul Glazkow",
  "files": [
    "dist",
    "docs"
  ],
  "bin": {
    "clapp-mcp": "./dist/bin/clapp-mcp.js"
  },
  "exports": {
    ".": {
      "default": "./dist/clapp-core.js",
      "types": "./dist/clapp-core.d.ts"
    }
  },
  "keywords": [
    "cli",
    "typescript",
    "commander",
    "plugin-system",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orion76/clapp.git",
    "directory": "packages/clapp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && chmod +x dist/bin/clapp-mcp.js",
    "watch": "npm run clean && tsc --watch",
    "clean": "rm -rf dist",
    "pack": "npm pack",
    "prepublishOnly": "npm run build",
    "test": "echo tests for clapp!",
    "test:jest": "jest",
    "install-libs": "./scripts/install.sh",
    "il": "npm run install-libs"
  },
  "peerDependencies": {
    "@clapp/common": "^0.0.1",
    "@clapp/utils": "^0.0.4",
    "commander": "^14.0.2",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "rollup": "^4.57.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentf/cli-styles": "^0.15.0",
    "@orion76/node-plugin": "^0.3.0",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.4.0",
    "tsx": "^4.20.6"
  }
}
